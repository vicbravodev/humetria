{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(composer test)",
      "Bash(npm run check)",
      "Bash(npm run types:check)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan config:show:*)",
      "Bash(php artisan migrate:status:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan list:*)",
      "Bash(php artisan make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh api -X PUT repos/vicbravodev/humetria/branches/main/protection:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-php-file.sh",
            "timeout": 120,
            "statusMessage": "Pint + PHPStan"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-frontend-file.sh",
            "timeout": 120,
            "statusMessage": "vp fmt + vp lint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-suite-on-stop.sh",
            "timeout": 600,
            "statusMessage": "Running composer test (+ frontend checks if TS/CSS changed)"
          }
        ]
      }
    ]
  }
}
