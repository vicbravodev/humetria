includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: max

    checkModelProperties: true
    checkMissingCallableSignature: true
    reportUnmatchedIgnoredErrors: true
