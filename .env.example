APP_NAME="Humetría"
APP_ENV=local
APP_KEY=
# Al rotar APP_KEY, deja aquí las llaves anteriores separadas por comas: así los enlaces del portal ya enviados siguen sirviendo.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
# The commit the running image was built from (the deployment sets it); empty = unknown.
APP_REVISION=
APP_PORT=80
# Proxies whose X-Forwarded-* headers are believed: comma-separated IPs/CIDRs, or * behind a load balancer. Empty = none.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=America/Mexico_City
# A dónde escribe una empresa para ampliar su plan o reactivarse; sin él, los avisos no llevan enlace de correo.
SUPPORT_EMAIL=
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Hides the user id inside a passkey; unset, it uses APP_KEY.
# PASSKEYS_USER_HANDLE_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days the daily channel keeps.
LOG_DAILY_DAYS=14
# Lowest level the posthog channel ships (PostHog Logs); add posthog to LOG_STACK to use it. Nothing leaves without POSTHOG_PROJECT_TOKEN.
LOG_POSTHOG_LEVEL=info

DB_CONNECTION=pgsql
# The app runs in Sail and reaches Postgres inside Docker; the tests run on the host through FORWARD_DB_PORT (phpunit.xml).
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
TENANT_LOGOS_DISK=public
TELEWORK_FILES_DISK=local
SEATING_FILES_DISK=local
INTERVENTION_FILES_DISK=local
DISCLOSURE_FILES_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailtrap-local
MAIL_PORT=3535
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LEGAL_NAME=
MAIL_LEGAL_ADDRESS=
MAIL_PRIVACY_URL=

# Survey emails per minute, across every company: the mail provider's limit.
CAMPAIGN_INVITATIONS_PER_MINUTE=60
CAMPAIGN_RESEND_COOLDOWN_HOURS=12

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The platform default of the fewest anonymous answers a group needs before its results are shown (criterio C-23), from 1
# to 50: each company follows it until its owner chooses its own, and every campaign or survey freezes it when it launches.
RESULTS_MIN_GROUP=5

# DB-IP city database for the location of a sign-in (`geoip:update` downloads it); unset, storage/app/private/geoip.
# GEOIP_DATABASE=

# Humi, the AI assistant: provider and model (keys of the providers: ANTHROPIC_API_KEY in config/ai.php).
HUMI_PROVIDER=anthropic
HUMI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Tokens per company per month, and messages per person per minute and per day; the company's own per-minute limit.
HUMI_MONTHLY_TOKEN_BUDGET=2000000
HUMI_RESERVATION_TOKENS=9000
HUMI_RATE_PER_MINUTE=10
HUMI_RATE_PER_DAY=200
HUMI_TENANT_RATE_PER_MINUTE=30

# NOM-035 complaints channel: the limits per hour of one address (kept hashed, in the limiter's cache only) and per day of
# one channel. Its summary follows the company's minimum of people per group.
COMPLAINTS_VIEWS_PER_HOUR=300
COMPLAINTS_SUBMISSIONS_PER_HOUR=5
COMPLAINTS_SUBMISSIONS_PER_DAY=10
COMPLAINTS_FOLLOW_UPS_PER_HOUR=30
COMPLAINTS_DAILY_CAP=200
COMPLAINTS_HELD_CAP=1000

# NOM-035 permanent page of the workers (policy, measures, results): requests per minute of one address and of the whole link.
DISCLOSURE_PAGE_PER_ADDRESS_PER_MINUTE=60
DISCLOSURE_PAGE_PER_LINK_PER_MINUTE=1200

# Time clock (registro de jornada): the screen's code window and the past windows accepted (seconds), the minutes the
# Marcar page remembers who marked, and the report's longest
# period on screen and in the CSV (days) and people read at a time. The legal limits are law, in the code.
ATTENDANCE_QR_WINDOW_SECONDS=30
ATTENDANCE_QR_PAST_WINDOWS=1
ATTENDANCE_QR_SCAN_MINUTES=3
ATTENDANCE_QR_BRANDED=false
ATTENDANCE_OFFLINE_ENABLED=true
ATTENDANCE_PUNCH_REMEMBER_MINUTES=10
ATTENDANCE_REPORT_PAGE_MAX_DAYS=93
ATTENDANCE_REPORT_EXPORT_MAX_DAYS=366
ATTENDANCE_REPORT_CHUNK_SIZE=200

# WorkerAccess (the key of the person who works): seconds a passkey challenge is good for.
WORKER_ACCESS_WEBAUTHN_CHALLENGE_SECONDS=60
WORKER_ACCESS_SESSION_IDLE_MINUTES=30
WORKER_ACCESS_SESSION_ABSOLUTE_HOURS=8
WORKER_ACCESS_ISSUED_LINK_HOURS=48
WORKER_ACCESS_REQUESTED_LINK_MINUTES=30
WORKER_ACCESS_PROOF_MINUTES=5
WORKER_ACCESS_PROOF_CODE_MINUTES=10
WORKER_ACCESS_PROOF_CODE_ATTEMPTS=5
WORKER_ACCESS_PROOF_CODE_SENDS=3
WORKER_ACCESS_MAX_KEYS=3
# true: switches the installed app's service worker off in every phone; never the delivery of offline marks.
PWA_SW_KILL=false
WORKER_ACCESS_DEVICE_KEYS_MAX=3
WORKER_ACCESS_OFFLINE_PASS_HOURS=24

# Vacaciones: business days a manager has to answer before a request reaches RH, days before the six-month window
# closes from which RH is warned, and the rows a file of opening balances may bring. The days by seniority are law.
LEAVE_ESCALATION_BUSINESS_DAYS=3
LEAVE_ENJOY_WINDOW_WARNING_DAYS=60
LEAVE_IMPORT_MAX_ROWS=2000

# Clima: comments a group needs before they are shown, and responses before the recommendation index and trend arrows.
# Neither can go under 10 and 30; a lower value is ignored.
ENGAGEMENT_MIN_COMMENTS=10
ENGAGEMENT_MIN_TREND=30

# Primeros pasos: el recorrido guiado del owner de una empresa nueva. false lo apaga por completo.
FIRST_STEPS_ENABLED=true

# SSR de la landing (Inertia): Node renderiza solo las páginas de App\Http\SsrPages. Apagado por omisión; INERTIA_SSR_ENABLED=false
# lo revierte en cualquier entorno. INERTIA_SSR_ENSURE_BUNDLE=false cuando el bundle vive en otro contenedor (producción).
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_TIMEOUT=2
INERTIA_SSR_ENSURE_BUNDLE=true

# PostHog (nube US), solo en la landing y solo para visitantes sin sesión. Sin token no hay bloque en el documento ni origen de PostHog en la CSP.
# No poner el token hasta publicar el aviso y la verificación legal. El consentimiento queda en denied hasta que el abogado del dueño indique otra cosa:
# con denied no se mide a los visitantes aunque el token esté puesto. Con token, el servidor además reporta sus errores (solo clase y traza, sin mensajes). El token es el público de proyecto (phc_…), nunca la llave personal (phx_…).
POSTHOG_PROJECT_TOKEN=
POSTHOG_CONSENT_DEFAULT=denied
# Anonymous, masked recording of a company's panel in PostHog: true to switch it on (the project needs Session Replay on).
POSTHOG_SESSION_RECORDING=false
# Anonymous replay of the landing's visits (what is typed is masked) and how fast its pages load: true to switch it on. Only with consent granted,
# for visitors without a session, and the project needs Session Replay on. Update the privacy notice's legal review before switching it on.
POSTHOG_LANDING_REPLAY=false
# The Google Ads conversion action the demo requests are imported into (Goals → Conversions); the name must match exactly.
GOOGLE_ADS_CONVERSION_NAME="Humetría · Solicitud de demo"

# SSO of Humetría's own staff (Google Workspace: https://accounts.google.com). Redirect URI: {APP_URL}/admin/sso-staff/callback
SSO_STAFF_ISSUER=
SSO_STAFF_CLIENT_ID=
SSO_STAFF_CLIENT_SECRET=
SSO_STAFF_DOMAIN=

# WhatsApp (Cloud API de Meta): un número central de Humetria, plantillas UTILITY. Apagado por omisión (gateway nulo).
# docs/superpowers/specs/2026-11-18-whatsapp-channel.md. Sin secretos aquí: los valores reales van en Dokploy.
WHATSAPP_ENABLED=false
WHATSAPP_PAUSED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# Solo durante una rotación del secreto de la app: se aceptan los dos.
# WHATSAPP_APP_SECRET_PREVIOUS=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_PER_SECOND=20
WHATSAPP_DAILY_CAP_PER_COMPANY=1000
WHATSAPP_PLATFORM_MONTHLY_CAP=20000

# Messaging: claves del HMAC del teléfono (versión:base64, separadas por coma; la mayor firma las filas nuevas). Obligatorias con
# WHATSAPP_ENABLED=true. No se quita una clave mientras exista una baja con su versión.
# MESSAGING_RECIPIENT_KEYS=
MESSAGING_RETENTION_MONTHS=12
MESSAGING_WEBHOOK_PER_MINUTE=6000
MESSAGING_WEBHOOK_MAX_BYTES=262144

# Webhook de Resend (firma Svix). El PREVIOUS solo durante una rotación.
# RESEND_WEBHOOK_SECRET=
# RESEND_WEBHOOK_SECRET_PREVIOUS=
