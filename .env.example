APP_NAME="Humetría"
APP_ENV=local
APP_KEY=
# Al rotar APP_KEY, deja aquí las llaves anteriores separadas por comas: así los enlaces del portal ya enviados siguen sirviendo.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
# Proxies whose X-Forwarded-* headers are believed: comma-separated IPs/CIDRs, or * behind a load balancer. Empty = none.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=America/Mexico_City
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Hides the user id inside a passkey; unset, it uses APP_KEY.
# PASSKEYS_USER_HANDLE_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days the daily channel keeps.
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
# The app runs in Sail and reaches Postgres inside Docker; the tests run on the host through FORWARD_DB_PORT (phpunit.xml).
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
TENANT_LOGOS_DISK=public
TELEWORK_FILES_DISK=local
SEATING_FILES_DISK=local
INTERVENTION_FILES_DISK=local
DISCLOSURE_FILES_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailtrap-local
MAIL_PORT=3535
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LEGAL_ADDRESS=
MAIL_PRIVACY_URL=

# Survey emails per minute, across every company: the mail provider's limit.
CAMPAIGN_INVITATIONS_PER_MINUTE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fewest anonymous questionnaires a group needs before its results are shown (never below 5).
RESULTS_MIN_GROUP=5

# DB-IP city database for the location of a sign-in (`geoip:update` downloads it); unset, storage/app/private/geoip.
# GEOIP_DATABASE=

# Humi, the AI assistant: provider and model (keys of the providers: ANTHROPIC_API_KEY in config/ai.php).
HUMI_PROVIDER=anthropic
HUMI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Tokens per company per month, and messages per person per minute and per day; the company's own per-minute limit.
HUMI_MONTHLY_TOKEN_BUDGET=2000000
HUMI_RESERVATION_TOKENS=9000
HUMI_RATE_PER_MINUTE=10
HUMI_RATE_PER_DAY=200
HUMI_TENANT_RATE_PER_MINUTE=30

# NOM-035 complaints channel: fewest complaints a cell of the summary needs (never below 5), and the limits per hour of one
# address (kept hashed, in the limiter's cache only) and per day of one channel.
COMPLAINTS_MIN_GROUP=5
COMPLAINTS_VIEWS_PER_HOUR=300
COMPLAINTS_SUBMISSIONS_PER_HOUR=5
COMPLAINTS_FOLLOW_UPS_PER_HOUR=30
COMPLAINTS_DAILY_CAP=200

# NOM-035 permanent page of the workers (policy, measures, results): requests per minute of one address and of the whole link.
DISCLOSURE_PAGE_PER_ADDRESS_PER_MINUTE=60
DISCLOSURE_PAGE_PER_LINK_PER_MINUTE=1200

# Time clock (registro de jornada): the screen's code window and the past windows accepted (seconds), the enrollment link's
# hours, the passkey challenge's seconds, the minutes the Marcar page remembers who marked, and the report's longest
# period on screen and in the CSV (days) and people read at a time. The legal limits are law, in the code.
ATTENDANCE_QR_WINDOW_SECONDS=30
ATTENDANCE_QR_PAST_WINDOWS=1
ATTENDANCE_ENROLLMENT_LINK_HOURS=48
ATTENDANCE_WEBAUTHN_CHALLENGE_SECONDS=60
ATTENDANCE_PUNCH_REMEMBER_MINUTES=10
ATTENDANCE_REPORT_PAGE_MAX_DAYS=93
ATTENDANCE_REPORT_EXPORT_MAX_DAYS=366
ATTENDANCE_REPORT_CHUNK_SIZE=200

# Vacaciones: business days a manager has to answer before a request reaches RH, days before the six-month window
# closes from which RH is warned, and the rows a file of opening balances may bring. The days by seniority are law.
LEAVE_ESCALATION_BUSINESS_DAYS=3
LEAVE_ENJOY_WINDOW_WARNING_DAYS=60
LEAVE_IMPORT_MAX_ROWS=2000

# Clima: comments a group needs before they are shown, and responses before the recommendation index and trend arrows.
# Neither can go under 10 and 30; a lower value is ignored.
ENGAGEMENT_MIN_COMMENTS=10
ENGAGEMENT_MIN_TREND=30
