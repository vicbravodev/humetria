{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "delapengineering/humetria",
    "type": "project",
    "description": "Humetría: plataforma SaaS de herramientas de RH.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-exif": "*",
        "ext-gd": "*",
        "bacon/bacon-qr-code": "^3.1.1",
        "brick/math": "^1.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^1.3",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50.1",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "maxmind-db/reader": "^1.14",
        "spatie/laravel-permission": "^8.3",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "worktree:setup": [
            "Composer\\Config::disableProcessTimeout",
            "scripts/worktree-setup.sh"
        ],
        "worktree:prune": "@php scripts/prune-test-databases.php",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "npm run test:js",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@test:coverage",
            "@test:browser"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel --exclude-testsuite=Browser --coverage-clover=coverage.xml",
            "@php scripts/coverage-min.php coverage.xml 90"
        ],
        "check:fast": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@test:fast"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --testsuite=Browser --parallel --processes=4"
        ],
        "test:fast": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel --processes=4 --tia --locally"
        ],
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --processes=4 --covered-only --exclude-testsuite=Browser --group=__pest_mutate_only"
        ],
        "mutate:retry": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --processes=4 --covered-only --exclude-testsuite=Browser --group=__pest_mutate_only --retry"
        ],
        "mutate:critical": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --processes=4 --exclude-testsuite=Browser --group=__pest_mutate_only --class=\"$(php scripts/mutation-classes.php tests | grep -vE '\\\\Http\\\\(Controllers|Requests)\\\\|\\\\Notifications\\\\' | paste -sd, -)\""
        ],
        "mutate:full": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --processes=4 --exclude-testsuite=Browser --group=__pest_mutate_only --min=95 --ignore-min-score-on-zero-mutations"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
