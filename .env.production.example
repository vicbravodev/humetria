# Plantilla del .env de producción (pestaña Environment de Dokploy, junto a compose.production.yaml).
# La lista completa de variables y su explicación está en .env.example; aquí van las que cambian en producción.
# Todo lo marcado con <> se llena; nada de esto lleva secretos reales en el repo.

APP_NAME="Humetría"
APP_ENV=production
APP_KEY=<base64:… de `php artisan key:generate --show`>
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://<dominio>
# Traefik de Dokploy es el único que llega al contenedor.
TRUSTED_PROXIES=*
SUPPORT_EMAIL=<soporte@dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=America/Mexico_City

# JSON a stderr: Docker lo recoge y Dokploy lo muestra.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Hostname interno del servicio Database de Dokploy.
DB_HOST=<host interno de Dokploy>
DB_PORT=5432
DB_DATABASE=humetria
DB_USERNAME=humetria
DB_PASSWORD=<contraseña>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
TENANT_LOGOS_DISK=public

QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=<contraseña larga>
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp del proveedor>
MAIL_PORT=465
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<contraseña>
MAIL_FROM_ADDRESS=<no-responder@dominio>
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LEGAL_ADDRESS=<domicilio legal>
MAIL_PRIVACY_URL=<url del aviso de privacidad>
# Correos de encuesta por minuto: el límite del proveedor de correo.
CAMPAIGN_INVITATIONS_PER_MINUTE=60

ANTHROPIC_API_KEY=<llave>
HUMI_PROVIDER=anthropic
HUMI_MODEL=claude-sonnet-5-5

# Imagen que descarga Dokploy; por omisión ghcr.io/vicbravodev/humetria:latest. Para fijar una versión: :sha-<commit>.
# HUMETRIA_IMAGE=ghcr.io/vicbravodev/humetria:sha-<commit>
