# Plantilla del .env de producción (pestaña Environment de Dokploy, junto a compose.production.yaml).
# La lista completa de variables y su explicación está en .env.example; aquí van las que cambian en producción.
# Todo lo marcado con <> se llena; nada de esto lleva secretos reales en el repo.

APP_NAME="Humetría"
APP_ENV=production
APP_KEY=<base64:… de `php artisan key:generate --show`>
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://<dominio>
# APP_REVISION no va aquí: la imagen trae el commit (Dockerfile) y una variable vacía en este .env lo borraría.
# Traefik de Dokploy es el único que llega al contenedor.
TRUSTED_PROXIES=*
SUPPORT_EMAIL=<soporte@dominio>
# Avisos push: las llaves salen de `php artisan notifications:vapid-keys` (cambiarlas obliga a cada app a volver a suscribirse).
VAPID_PUBLIC_KEY=<llave pública>
VAPID_PRIVATE_KEY=<llave privada>
VAPID_SUBJECT=mailto:<soporte@dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=America/Mexico_City

# JSON a stderr (Docker lo recoge y Dokploy lo muestra) y a PostHog Logs, que guarda y alerta (docs/operations/observability.md).
# Sin POSTHOG_PROJECT_TOKEN el canal posthog no manda nada.
LOG_CHANNEL=stack
LOG_STACK=stderr,posthog
LOG_LEVEL=info
LOG_POSTHOG_LEVEL=info

DB_CONNECTION=pgsql
# Hostname interno del servicio Database de Dokploy.
DB_HOST=<host interno de Dokploy>
DB_PORT=5432
DB_DATABASE=humetria
DB_USERNAME=humetria
DB_PASSWORD=<contraseña>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
TENANT_LOGOS_DISK=public

QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=<contraseña larga>
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp del proveedor>
MAIL_PORT=465
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<contraseña>
MAIL_FROM_ADDRESS=<no-responder@dominio>
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LEGAL_NAME=<razón social del responsable>
MAIL_LEGAL_ADDRESS=<domicilio legal>
MAIL_PRIVACY_URL=https://<dominio>/privacy-notice
# Correos de encuesta por minuto: el límite del proveedor de correo.
CAMPAIGN_INVITATIONS_PER_MINUTE=60

ANTHROPIC_API_KEY=<llave>
HUMI_PROVIDER=anthropic
HUMI_MODEL=claude-sonnet-5-5

# SSR de la landing: el servicio `ssr` (otra imagen, red interna) renderiza `/` y el aviso de privacidad.
# Interruptor: false y reiniciar `web` (la configuración se cachea al arrancar) = la landing vuelve a pintarse en el navegador.
# El bundle vive en la imagen de `ssr`, no en `web`: sin INERTIA_SSR_ENSURE_BUNDLE=false el gateway nunca llama a Node.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://humetria-ssr:13714
INERTIA_SSR_TIMEOUT=2
INERTIA_SSR_ENSURE_BUNDLE=false

# Imágenes que descarga Dokploy: ghcr.io/vicbravodev/humetria y ghcr.io/vicbravodev/humetria-ssr (HUMETRIA_IMAGE y
# HUMETRIA_SSR_IMAGE, repositorio sin etiqueta). Las dos van a la misma etiqueta: por omisión `latest`; para fijar una versión
# o volver a una anterior, un commit que ya publicó deploy.yml.
# HUMETRIA_IMAGE=ghcr.io/vicbravodev/humetria
# HUMETRIA_TAG=sha-<commit>

# PostHog (nube US): vacío hasta publicar el aviso de privacidad y tener la verificación legal (LFPDPPP). Con el token y
# POSTHOG_CONSENT_DEFAULT=granted la landing arranca posthog-js; con denied no se mide a los visitantes. Con token el servidor
# también reporta sus errores (clase y traza, sin mensajes; docs/operations/ssr.md §8). Antes de poner
# el token: confirmar en el navegador, con un token real, que no hay violaciones de la CSP (SecurityHeaders::POSTHOG_ORIGIN).
POSTHOG_PROJECT_TOKEN=
POSTHOG_CONSENT_DEFAULT=denied

# WhatsApp (Cloud API de Meta): un número central de Humetria, plantillas UTILITY. Apagado por omisión (gateway nulo).
# docs/superpowers/specs/2026-11-18-whatsapp-channel.md. Sin secretos aquí: los valores reales van en Dokploy.
WHATSAPP_ENABLED=false
WHATSAPP_PAUSED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Solo durante una rotación del secreto de la app: se aceptan los dos.
WHATSAPP_APP_SECRET_PREVIOUS=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MAX_PER_SECOND=20
WHATSAPP_DAILY_CAP_PER_COMPANY=1000
WHATSAPP_PLATFORM_MONTHLY_CAP=20000

# Messaging: claves del HMAC del teléfono (versión:base64, separadas por coma; la mayor firma las filas nuevas). Obligatorias con
# WHATSAPP_ENABLED=true. No se quita una clave mientras exista una baja con su versión.
MESSAGING_RECIPIENT_KEYS=
MESSAGING_RETENTION_MONTHS=12
MESSAGING_WEBHOOK_PER_MINUTE=6000
MESSAGING_WEBHOOK_MAX_BYTES=262144

# Webhook de Resend (firma Svix). El PREVIOUS solo durante una rotación.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET_PREVIOUS=
