  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
